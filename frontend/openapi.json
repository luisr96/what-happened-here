{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "What Happened Here API",
    "description" : "Events from Wikidata with a time and a place. Errors are RFC 9457 problem details (application/problem+json).",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/stats/timeline" : {
      "get" : {
        "tags" : [ "events-controller" ],
        "summary" : "Event counts per decade in a viewport, for the time slider",
        "description" : "Each event counts once, in the decade of its earliestYear (floor(year / 10) * 10, so -44 falls in -50). Covers all time.",
        "operationId" : "timeline",
        "parameters" : [ {
          "name" : "bbox",
          "in" : "query",
          "description" : "Viewport as minLon,minLat,maxLon,maxLat in degrees (lon -180..180, lat -90..90, edges included). minLon > maxLon means the box crosses the antimeridian, e.g. 170,-10,-170,10. Large boxes are snapped outward to whole grid cells (10, 1 or 0.1 degrees, at least 10 cells across), so counts may include events up to one cell outside; boxes narrower or shorter than 1 degree are counted exactly.",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "-10,35,30,60"
        }, {
          "name" : "kinds",
          "in" : "query",
          "description" : "Comma list of kinds, case-insensitive: HAPPENED, BORN, DIED, FOUNDED, ENDED, OPENED. Omit for all kinds.",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "minImportance",
          "in" : "query",
          "description" : "Only items with at least this many Wikipedia sitelinks; >= 0.",
          "required" : false,
          "schema" : {
            "type" : "string",
            "minimum" : 0
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/TimelineResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid, missing or malformed parameter",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/stats/summary" : {
      "get" : {
        "tags" : [ "stats-summary-controller" ],
        "summary" : "Whole-dataset numbers: events, places, events per kind, years covered",
        "description" : "Counted once per API start; the data only changes with a re-import.",
        "operationId" : "summary",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StatsSummary"
                }
              }
            }
          }
        }
      }
    },
    "/places/nearby" : {
      "get" : {
        "tags" : [ "events-controller" ],
        "summary" : "Events within a radius of a point, most important first",
        "operationId" : "nearby",
        "parameters" : [ {
          "name" : "lat",
          "in" : "query",
          "description" : "Latitude of the centre, -90..90",
          "required" : true,
          "schema" : {
            "type" : "number",
            "format" : "double"
          },
          "example" : 48.8566
        }, {
          "name" : "lon",
          "in" : "query",
          "description" : "Longitude of the centre, -180..180",
          "required" : true,
          "schema" : {
            "type" : "number",
            "format" : "double"
          },
          "example" : 2.3522
        }, {
          "name" : "radius",
          "in" : "query",
          "description" : "Radius in metres, 1..500000, measured on the spheroid.",
          "required" : true,
          "schema" : {
            "type" : "string",
            "maximum" : 500000,
            "minimum" : 1
          },
          "example" : 5000
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Earliest year wanted; negative for BC (-1 is 1 BC). An event matches when its year range [earliestYear, latestYear] overlaps from..to. Omit for no lower bound.",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "to",
          "in" : "query",
          "description" : "Latest year wanted; negative for BC. An event matches when its year range [earliestYear, latestYear] overlaps from..to. Omit for no upper bound.",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "kinds",
          "in" : "query",
          "description" : "Comma list of kinds, case-insensitive: HAPPENED, BORN, DIED, FOUNDED, ENDED, OPENED. Omit for all kinds.",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "minImportance",
          "in" : "query",
          "description" : "Only items with at least this many Wikipedia sitelinks; >= 0.",
          "required" : false,
          "schema" : {
            "type" : "string",
            "minimum" : 0
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Maximum events returned, 1..2000; the most important come first and truncated says whether more matched.",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "default" : 500,
            "maximum" : 2000,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventsResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid, missing or malformed parameter",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/events" : {
      "get" : {
        "tags" : [ "events-controller" ],
        "summary" : "Events in a viewport and time window, most important first",
        "operationId" : "events",
        "parameters" : [ {
          "name" : "bbox",
          "in" : "query",
          "description" : "Viewport as minLon,minLat,maxLon,maxLat in degrees (lon -180..180, lat -90..90, edges included). minLon > maxLon means the box crosses the antimeridian, e.g. 170,-10,-170,10.",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "-10,35,30,60"
        }, {
          "name" : "from",
          "in" : "query",
          "description" : "Earliest year wanted; negative for BC (-1 is 1 BC). An event matches when its year range [earliestYear, latestYear] overlaps from..to. Omit for no lower bound.",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "to",
          "in" : "query",
          "description" : "Latest year wanted; negative for BC. An event matches when its year range [earliestYear, latestYear] overlaps from..to. Omit for no upper bound.",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "name" : "kinds",
          "in" : "query",
          "description" : "Comma list of kinds, case-insensitive: HAPPENED, BORN, DIED, FOUNDED, ENDED, OPENED. Omit for all kinds.",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "minImportance",
          "in" : "query",
          "description" : "Only items with at least this many Wikipedia sitelinks; >= 0.",
          "required" : false,
          "schema" : {
            "type" : "string",
            "minimum" : 0
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Maximum events returned, 1..2000; the most important come first and truncated says whether more matched.",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "default" : 500,
            "maximum" : 2000,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventsResponse"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid, missing or malformed parameter",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/events/{id}" : {
      "get" : {
        "tags" : [ "events-controller" ],
        "summary" : "One event with its item's English Wikipedia summary",
        "operationId" : "event",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "<QID>:<KIND>, e.g. Q254:BORN",
          "required" : true,
          "schema" : {
            "type" : "string"
          },
          "example" : "Q254:BORN"
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EventDetails"
                }
              }
            }
          },
          "400" : {
            "description" : "Invalid, missing or malformed parameter",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "No event with this id",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "DecadeCount" : {
        "type" : "object",
        "properties" : {
          "decade" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "First year of the decade, floor(year / 10) * 10: -50 covers -50..-41"
          },
          "count" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Events in the decade"
          }
        },
        "required" : [ "count", "decade" ]
      },
      "TimelineResponse" : {
        "type" : "object",
        "properties" : {
          "decades" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DecadeCount"
            }
          }
        },
        "required" : [ "decades" ]
      },
      "StatsSummary" : {
        "type" : "object",
        "properties" : {
          "events" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "All events on the map"
          },
          "places" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Places in the database (items whose coordinates events use)"
          },
          "eventsByKind" : {
            "type" : "object",
            "additionalProperties" : {
              "type" : "integer",
              "format" : "int64"
            },
            "description" : "Events per kind; every kind is listed, 0 when it has none"
          },
          "earliestYear" : {
            "type" : [ "integer", "null" ],
            "format" : "int64",
            "description" : "Earliest year of any event (negative for BC); null without events"
          },
          "latestYear" : {
            "type" : [ "integer", "null" ],
            "format" : "int64",
            "description" : "Latest year of any event; null without events"
          },
          "dumpDate" : {
            "type" : [ "string", "null" ],
            "description" : "Date of the Wikidata dump the data comes from (YYYY-MM-DD); null when not configured",
            "example" : "2026-10-12"
          }
        },
        "required" : [ "dumpDate", "earliestYear", "events", "eventsByKind", "latestYear", "places" ]
      },
      "DateView" : {
        "type" : "object",
        "properties" : {
          "year" : {
            "type" : "integer",
            "format" : "int64"
          },
          "month" : {
            "type" : "integer",
            "format" : "int32"
          },
          "day" : {
            "type" : "integer",
            "format" : "int32"
          },
          "precision" : {
            "type" : "string",
            "description" : "Finest unit the date states",
            "enum" : [ "MILLENNIUM", "CENTURY", "DECADE", "YEAR", "MONTH", "DAY" ]
          },
          "calendar" : {
            "type" : "string",
            "description" : "Calendar as written (not converted)",
            "enum" : [ "GREGORIAN", "JULIAN" ]
          }
        },
        "required" : [ "calendar", "day", "month", "precision", "year" ]
      },
      "EventView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "description" : "<QID>:<KIND>, e.g. Q254:BORN"
          },
          "itemId" : {
            "type" : "string",
            "description" : "Wikidata item, e.g. Q254"
          },
          "kind" : {
            "type" : "string",
            "description" : "Kind of moment",
            "enum" : [ "HAPPENED", "BORN", "DIED", "FOUNDED", "ENDED", "OPENED" ]
          },
          "label" : {
            "type" : [ "string", "null" ],
            "description" : "English label, or null"
          },
          "importance" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Number of Wikipedias linking to the item"
          },
          "when" : {
            "$ref" : "#/components/schemas/DateView",
            "description" : "When it happened, at the precision Wikidata states"
          },
          "end" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/DateView"
            }, {
              "type" : "null"
            } ],
            "description" : "End of a range, or null for a point in time"
          },
          "earliestYear" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "First year the event may fall in, given its precision (a century spans 100 years); negative for BC"
          },
          "latestYear" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Last year the event may fall in (of the end date if any)"
          },
          "latitude" : {
            "type" : "number",
            "format" : "double",
            "description" : "WGS84 degrees: the item's own or its place's coordinates"
          },
          "longitude" : {
            "type" : "number",
            "format" : "double",
            "description" : "WGS84 degrees: the item's own or its place's coordinates"
          },
          "coordPrecisionDeg" : {
            "type" : [ "number", "null" ],
            "format" : "double",
            "description" : "Coordinate precision in degrees, or null when unknown"
          },
          "approximate" : {
            "type" : "boolean",
            "description" : "Show as approximate: precision unknown or at least 0.1 degrees"
          },
          "placeQid" : {
            "type" : [ "string", "null" ],
            "description" : "Place whose coordinates were used, or null for the item's own P625 coordinates"
          }
        },
        "required" : [ "approximate", "coordPrecisionDeg", "earliestYear", "end", "id", "importance", "itemId", "kind", "label", "latestYear", "latitude", "longitude", "placeQid", "when" ]
      },
      "EventsResponse" : {
        "type" : "object",
        "properties" : {
          "events" : {
            "type" : "array",
            "description" : "Matching events, most important first",
            "items" : {
              "$ref" : "#/components/schemas/EventView"
            }
          },
          "truncated" : {
            "type" : "boolean",
            "description" : "True when more events matched than were returned (raise minImportance or zoom in)"
          }
        },
        "required" : [ "events", "truncated" ]
      },
      "EventDetails" : {
        "type" : "object",
        "properties" : {
          "event" : {
            "$ref" : "#/components/schemas/EventView",
            "description" : "The event, as in /events"
          },
          "wikipedia" : {
            "anyOf" : [ {
              "$ref" : "#/components/schemas/WikipediaSummary"
            }, {
              "type" : "null"
            } ],
            "description" : "English Wikipedia summary of the event's item, or null when it has no article or Wikipedia could not be reached"
          }
        },
        "required" : [ "event", "wikipedia" ]
      },
      "WikipediaSummary" : {
        "type" : "object",
        "properties" : {
          "title" : {
            "type" : "string",
            "description" : "Article title as Wikipedia displays it"
          },
          "extract" : {
            "type" : "string",
            "description" : "First paragraph, plain text"
          },
          "url" : {
            "type" : "string",
            "description" : "Link to the article"
          },
          "thumbnailUrl" : {
            "type" : [ "string", "null" ],
            "description" : "Lead image URL, or null when the article has none"
          }
        },
        "required" : [ "extract", "thumbnailUrl", "title", "url" ]
      }
    }
  }
}
